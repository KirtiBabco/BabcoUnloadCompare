<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="BabcoUnloadCompare.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /> - Babco Foods</title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/site.css?v=1.3.1") %>" />
    <style>
      .standard-app-header{position:fixed;top:0;left:0;right:0;z-index:200;height:76px;display:grid;grid-template-columns:minmax(270px,1fr) auto minmax(330px,1fr);align-items:center;gap:18px;padding:0 22px;background:linear-gradient(90deg,#ffffff 0%,#fff8e8 48%,#ffffff 100%);border-bottom:1px solid #dec16a;box-shadow:0 3px 16px rgba(74,57,12,.10)}
      .std-brand{display:flex;align-items:center;gap:11px;min-width:0;height:56px}
      .std-labs-logo{display:block;width:168px;height:auto;max-height:52px;object-fit:contain;object-position:left center;flex:0 0 auto}
      .std-brand-text{min-width:0;padding-left:10px;border-left:1px solid #eadfbf;padding-top:3px;padding-bottom:3px}
      .std-brand-text strong{display:block;font-size:13px;line-height:1.1;color:#211a14;font-weight:900;letter-spacing:.15px;white-space:nowrap}
      .std-brand-text small{display:block;margin-top:4px;font-size:10px;color:#7a6a54;font-weight:750;letter-spacing:.3px;text-transform:uppercase;white-space:nowrap}
      .std-brand-version{display:inline-block;margin-left:5px;padding-left:6px;border-left:1px solid #cdbb8c;color:#7f1d2d;font-weight:950;letter-spacing:.15px;text-transform:none}
      .prototype-banner{justify-self:center;display:flex;align-items:center;justify-content:center;gap:14px;min-height:46px;padding:8px 20px;background:linear-gradient(90deg,#fff4bf 0%,#ffe8a0 48%,#fff4bf 100%);color:#5b4300;border:1px solid #d6b14a;border-left:6px solid #7f1d2d;border-radius:14px;box-shadow:0 2px 10px rgba(74,57,12,.08);text-align:center}
      .prototype-banner strong{font-size:25px;line-height:1;font-weight:950;letter-spacing:2.2px;color:#7f1d2d;text-shadow:0 1px 0 rgba(255,255,255,.8)}
      .prototype-banner span{font-size:13px;font-weight:750;letter-spacing:.05px;color:#65511a}
      .std-account-area{justify-self:end;display:flex;align-items:center;gap:8px;min-width:0}
      .std-mode-note{text-align:right;display:flex;flex-direction:column;gap:2px;padding-right:10px;border-right:1px solid #e7dcc2;color:#5f4b00}
      .std-mode-note strong{font-size:11px;font-weight:950;letter-spacing:.8px;text-transform:uppercase;color:#7f1d2d;white-space:nowrap}
      .std-mode-note small{font-size:9px;font-weight:700;color:#7b6b52;white-space:nowrap}
      .std-feedback-btn{min-height:32px;padding:0 12px;border-radius:9px;border:1px solid #d8c28c;background:#fff;color:#7f1d2d;font-size:10px;font-weight:900;cursor:pointer;white-space:nowrap}.std-feedback-btn:hover{background:#fff4d9}.std-feedback-btn:focus-visible{outline:3px solid rgba(127,29,45,.18);outline-offset:2px}
      .std-user-card{display:grid;grid-template-columns:38px minmax(110px,auto) auto;align-items:center;gap:9px;min-height:50px;padding:6px 9px 6px 7px;background:rgba(255,255,255,.88);border:1px solid #e8dfca;border-radius:15px;box-shadow:0 3px 12px rgba(50,39,20,.07)}
      .std-user-avatar{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,#7f1d2d,#a53a4b);color:#fff;font-size:13px;font-weight:950;letter-spacing:.5px;box-shadow:0 3px 9px rgba(127,29,45,.18)}
      .std-user-meta{min-width:0;line-height:1.15}.std-user-meta strong{display:block;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#2c251d;font-size:12px;font-weight:900}.std-user-meta small{display:block;margin-top:4px;color:#81745f;font-size:9px;font-weight:700;white-space:nowrap}
      .std-signout{display:inline-flex;align-items:center;justify-content:center;min-height:30px;padding:0 9px;border-radius:9px;border:1px solid #e1d3b8;background:#fffaf0;color:#7f1d2d;text-decoration:none;font-size:9px;font-weight:900;white-space:nowrap}.std-signout:hover{background:#fff1d2;border-color:#d7bd80}
      body{padding-top:76px}.sidebar{top:76px!important}.sidebar-overlay{top:76px!important}
      .entra-signout{display:inline-block;margin-top:4px;color:#7f1d2d;text-decoration:none;font-size:10px;font-weight:800}.entra-signout:hover{text-decoration:underline}
      .sidebar-user{margin:10px 11px 14px!important;padding:11px!important;border:1px solid #eee3cf!important;border-radius:14px!important;background:linear-gradient(145deg,#fffdf8,#fff8e9)!important;box-shadow:0 4px 14px rgba(45,35,20,.06)!important}.sidebar-user .user-avatar{box-shadow:0 3px 9px rgba(127,29,45,.16)}.sidebar-user strong{max-width:140px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sidebar-user small{font-weight:700}
      .feedback-modal{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(30,24,17,.48);backdrop-filter:blur(2px)}.feedback-modal.hidden{display:none}.feedback-card{width:min(520px,100%);background:#fff;border:1px solid #ead9b4;border-radius:18px;box-shadow:0 24px 70px rgba(35,27,18,.26);padding:20px}.feedback-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.feedback-head h3{margin:3px 0 0;font-size:20px;color:#2d2319}.feedback-head small{font-weight:800;color:#8a6b18}.feedback-close{border:0;background:#fff5df;color:#7f1d2d;border-radius:10px;width:34px;height:34px;font-size:20px;font-weight:900;cursor:pointer}.feedback-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.feedback-field{display:flex;flex-direction:column;gap:6px}.feedback-field.full{grid-column:1/-1}.feedback-field label{font-size:11px;font-weight:900;color:#5f513e}.feedback-field select,.feedback-field textarea{width:100%;box-sizing:border-box;border:1px solid #d9cfbd;border-radius:10px;background:#fff;padding:10px;font:inherit;color:#2d261d}.feedback-field textarea{min-height:116px;resize:vertical}.feedback-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}.feedback-actions small{color:#7b6e5b;font-size:10px}.feedback-submit{border:0;border-radius:10px;background:#7f1d2d;color:#fff;min-height:38px;padding:0 16px;font-weight:900;cursor:pointer}.feedback-submit:disabled{opacity:.6;cursor:wait}
      @media(max-width:1180px){.standard-app-header{grid-template-columns:minmax(190px,.8fr) auto minmax(220px,.8fr);gap:10px;padding:0 14px}.std-labs-logo{width:132px}.std-brand-text small{display:block;font-size:9px}.std-mode-note{display:none}.std-user-card{grid-template-columns:36px auto;padding-right:7px}.std-user-avatar{width:36px;height:36px}.std-user-meta small,.std-signout{display:none}.std-user-meta strong{max-width:115px}.prototype-banner{padding:8px 14px}.prototype-banner span{font-size:11px}}
      @media(max-width:820px){.standard-app-header{height:64px;grid-template-columns:auto 1fr auto;padding:0 10px}.std-brand{height:48px}.std-labs-logo{width:104px;max-height:43px}.std-brand-text{display:none}.prototype-banner{justify-self:center;gap:7px;padding:7px 10px;min-height:38px}.prototype-banner strong{font-size:18px;letter-spacing:1.5px}.prototype-banner span{display:none}.std-user-card{display:flex;padding:5px;border-radius:12px;min-height:0}.std-user-meta{display:none}.std-user-avatar{width:34px;height:34px;border-radius:10px}.std-feedback-btn{display:none}body{padding-top:64px}.sidebar{top:64px!important}.sidebar-overlay{top:64px!important}.mobile-appbar{top:64px!important}}
      @media(max-width:480px){.standard-app-header{height:58px}.std-labs-logo{width:90px}.prototype-banner strong{font-size:16px}.std-user-avatar{display:none}body{padding-top:58px}.sidebar{top:58px!important}.sidebar-overlay{top:58px!important}.mobile-appbar{top:58px!important}.feedback-fields{grid-template-columns:1fr}.feedback-field.full{grid-column:auto}}
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="MainForm" runat="server">
<header class="standard-app-header" role="banner" aria-label="Babco standard project header">
  <div class="std-brand" id="stdBrand">
    <img id="stdLabsLogo" class="std-labs-logo" src="<%= ResolveUrl("~/Content/babco-labs-logo.svg") %>" alt="Babco Labs" width="168" height="43" />
    <div class="std-brand-text"><strong>Babco Foods</strong><small>Warehouse Operations <span class="std-brand-version">v1.3.1</span></small></div>
  </div>
  <div class="prototype-banner" role="status" aria-label="Prototype notice"><strong>PROTOTYPE</strong><span>&mdash; This is a prototype and not the final production website.</span></div>
  <div class="std-account-area">
    <div class="std-mode-note"><strong>Without AI</strong><small>Core receiving workflow</small></div>
    <button id="stdFeedbackBtn" type="button" class="std-feedback-btn" onclick="document.getElementById('feedbackModal').classList.remove('hidden');var c=document.getElementById('feedbackComments');if(c){setTimeout(function(){c.focus();},50);}return false;">Feedback</button>
    <div class="std-user-card" aria-label="Signed in user">
      <span class="std-user-avatar"><%= Server.HtmlEncode(UserInitials) %></span>
      <div class="std-user-meta"><strong title="<%= Server.HtmlEncode(DisplayName) %>"><%= Server.HtmlEncode(DisplayName) %></strong><small><%= Server.HtmlEncode(AuthenticationLabel) %></small></div>
      <% if (ShowSignOut) { %><a class="std-signout" href="<%= ResolveUrl("~/.auth/logout?post_logout_redirect_uri=/") %>">Sign out</a><% } %>
    </div>
  </div>
</header>
<div class="app-layout">
  <aside id="appSidebar" class="sidebar" aria-label="Main navigation">
    <div class="sidebar-brand">
      <span class="brand-mark">B</span>
      <div><strong>Babco Foods</strong><small>Warehouse Operations</small></div>
      <button type="button" class="sidebar-close" aria-label="Close menu" onclick="App.closeSidebar()">&times;</button>
    </div>
    <nav class="side-nav">
      <a class="side-nav-link" data-nav="UnloadCompare.aspx" href="<%= ResolveUrl("~/UnloadCompare.aspx") %>"><span class="nav-icon">UC</span><span><b>Unload Compare</b><small>PackingSlip receiving &amp; count</small></span></a>
      <a class="side-nav-link" data-nav="UnloadCompareHistory.aspx" href="<%= ResolveUrl("~/UnloadCompareHistory.aspx") %>"><span class="nav-icon">RH</span><span><b>Receiving History</b><small>Previous records</small></span></a>
    </nav>
    <div class="sidebar-spacer"></div>
    <div class="sidebar-user"><span class="user-avatar"><%= Server.HtmlEncode(UserInitials) %></span><div><strong><%= Server.HtmlEncode(DisplayName) %></strong><small><%= Server.HtmlEncode(AuthenticationLabel) %></small><% if (ShowSignOut) { %><a class="entra-signout" href="<%= ResolveUrl("~/.auth/logout?post_logout_redirect_uri=/") %>">Sign out</a><% } %></div></div>
  </aside>
  <div id="sidebarOverlay" class="sidebar-overlay" onclick="App.closeSidebar()"></div>
  <div class="app-main">
    <header class="mobile-appbar">
      <button type="button" class="menu-toggle" aria-label="Open menu" onclick="App.openSidebar()"><span></span><span></span><span></span></button>
      <strong>Babco Foods</strong><span class="mobile-section">Receiving</span>
    </header>
    <main class="page-shell"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
  </div>
</div>
<div id="feedbackModal" class="feedback-modal hidden" role="dialog" aria-modal="true" aria-labelledby="feedbackTitle">
  <div class="feedback-card">
    <div class="feedback-head"><div><small>UNLOAD COMPARE &middot; v1.3.1</small><h3 id="feedbackTitle">Feedback Form</h3></div><button type="button" class="feedback-close" aria-label="Close feedback" onclick="document.getElementById('feedbackModal').classList.add('hidden');return false;">&times;</button></div>
    <div id="feedbackForm" class="feedback-fields">
      <div class="feedback-field"><label for="feedbackType">Type</label><select id="feedbackType"><option>General</option><option>Bug Report</option><option>Feature Request</option><option>User Experience</option></select></div>
      <div class="feedback-field"><label for="feedbackRating">Rating</label><select id="feedbackRating"><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Okay</option><option value="2">2 - Needs work</option><option value="1">1 - Poor</option></select></div>
      <div class="feedback-field full"><label for="feedbackComments">Comments</label><textarea id="feedbackComments" maxlength="4000" placeholder="What worked, what failed, or what should we improve?"></textarea></div>
    </div>
    <div class="feedback-actions"><small>Page + version + signed-in user are recorded with the feedback.</small><button id="feedbackSubmitBtn" type="button" class="feedback-submit" onclick="App.submitFeedback(event)">Submit Feedback</button></div>
  </div>
</div>
</form>
<script src="<%= ResolveUrl("~/Scripts/common.js?v=1.3.1") %>"></script>
<script>
(function(){
  function labelText(value){
    if(!value)return value;
    return String(value).replace(/\bPO Number\b/g,'PackingSlip').replace(/\bPO\b/g,'PackingSlip');
  }
  function applyLabels(root){
    if(!root)return;
    var walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,null);
    var nodes=[];
    while(walker.nextNode())nodes.push(walker.currentNode);
    nodes.forEach(function(n){
      var p=n.parentNode;
      if(!p||/^(SCRIPT|STYLE)$/i.test(p.nodeName))return;
      var v=labelText(n.nodeValue);
      if(v!==n.nodeValue)n.nodeValue=v;
    });
    if(root.querySelectorAll){
      root.querySelectorAll('[placeholder],[title],[aria-label],input[type="button"],input[type="submit"]').forEach(function(el){
        ['placeholder','title','aria-label','value'].forEach(function(a){
          if(!el.hasAttribute(a))return;
          var old=el.getAttribute(a),v=labelText(old);
          if(v!==old)el.setAttribute(a,v);
        });
      });
    }
  }
  document.addEventListener('DOMContentLoaded',function(){
    applyLabels(document.body);
    new MutationObserver(function(changes){
      changes.forEach(function(m){
        if(m.type==='characterData'){
          var p=m.target.parentNode;
          if(p&&!/^(SCRIPT|STYLE)$/i.test(p.nodeName)){
            var v=labelText(m.target.nodeValue);
            if(v!==m.target.nodeValue)m.target.nodeValue=v;
          }
        }else if(m.type==='childList'){
          Array.prototype.forEach.call(m.addedNodes,function(n){
            if(n.nodeType===1)applyLabels(n);
            else if(n.nodeType===3&&n.parentNode)applyLabels(n.parentNode);
          });
        }else if(m.type==='attributes'){
          var old=m.target.getAttribute(m.attributeName),v=labelText(old);
          if(v!==old)m.target.setAttribute(m.attributeName,v);
        }
      });
    }).observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['placeholder','title','aria-label','value']});
  });
})();
</script>
<asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
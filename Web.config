<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="UnloadCompareConnectionString" connectionString="Data Source=.;Initial Catalog=BabcoUnloadCompare;Integrated Security=True;Connect Timeout=300;" providerName="System.Data.SqlClient" />
    <add name="BabcoSupportConnectionString" connectionString="Data Source=.;Initial Catalog=Babco;Integrated Security=True;Connect Timeout=300;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="UnloadCompare.UploadRoot" value="~/App_Data/Uploads/UnloadCompare" />
    <add key="UnloadCompare.MaxUploadMB" value="15" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="15360" executionTimeout="120" requestValidationMode="4.5" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Static" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="en-US" uiCulture="en" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="Default.aspx" /><add value="UnloadCompare.aspx" /></files></defaultDocument>
    <validation validateIntegratedModeConfiguration="false" />
    <security><requestFiltering><requestLimits maxAllowedContentLength="15728640" /></requestFiltering></security>
  </system.webServer>
</configuration>